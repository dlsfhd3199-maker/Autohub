# Supabase project URL. Obtain it from local Supabase status or the project Connect panel.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase publishable key. Never use a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical application origin used for authentication redirects.
NEXT_PUBLIC_APP_URL=

# PostgreSQL connection used by local migrations and server-only operations.
DATABASE_URL=

# Isolated PostgreSQL connection used only by automated integration tests.
TEST_DATABASE_URL=

# Server-only OpenAI credential. Enter only in .env.local before checkpoint 6C.
OPENAI_API_KEY=

# Fixed PoC generation model and hard local usage limits.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_DAILY_JOB_LIMIT=3
OPENAI_MAX_INPUT_TOKENS_PER_JOB=40000
OPENAI_MAX_OUTPUT_TOKENS_PER_JOB=12000
OPENAI_MAX_PLAN_OUTPUT_TOKENS=3000
OPENAI_MAX_DRAFT_OUTPUT_TOKENS=9000
OPENAI_MAX_COST_PER_JOB_USD=0.60
OPENAI_MAX_CONCURRENT_JOBS=1
